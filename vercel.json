{
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/ads.txt",
      "destination": "/ads.txt"
    },
    {
      "source": "/article/news/:id*",
      "destination": "/api/article?category=actus&id=:id"
    },
    {
      "source": "/article/:category/:id*",
      "destination": "/api/article?category=:category&id=:id"
    },
    {
      "source": "/api/:path*",
      "destination": "/api/:path*"
    },
    {
      "source": "/((?!api/|_next/|static/|.*\\..*).*)",
      "destination": "/index.html"
    }
  ]
}